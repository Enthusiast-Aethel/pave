# Server Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection String (required)
# Get this from MongoDB Atlas: Clusters → Connect → Connect your application
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/pave?retryWrites=true&w=majority

# JWT Secret for authentication (required)
# Generate a secure random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here

# Client URL for CORS (required for production)
# Comma-separated list of allowed origins
CLIENT_URL=https://pave-omega.vercel.app,https://localhost,capacitor://localhost,http://localhost:5173

# Server Port (optional, defaults to 5000)
PORT=5000

# Backup Configuration (optional)
# Directory where backups are stored (relative to server folder)
BACKUP_DIR=./backups

# Email Configuration (for password reset)
# Configure SMTP to send password reset emails
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM=Pave <noreply@pave.app>

# Without email config, reset links will be logged to console (dev mode)